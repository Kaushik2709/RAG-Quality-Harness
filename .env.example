# ==============================================================================
# RAG Evaluation & Observability Platform — Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM PROVIDER & API KEYS
# ------------------------------------------------------------------------------
# [REQUIRED] Active LLM provider for response generation and evaluation judge.
# Options: "gemini" or "claude"
LLM_PROVIDER=gemini

# [REQUIRED if LLM_PROVIDER=gemini] Your Google Gemini API Key
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Gemini Model name (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-flash-latest, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# [OPTIONAL] Set if LLM_PROVIDER=claude
# CLAUDE_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-3-5-sonnet-20240620

# ------------------------------------------------------------------------------
# 2. EMBEDDER & RERANKER MODELS
# ------------------------------------------------------------------------------
# [OPTIONAL] Embedding model for dense vector indexing (default: models/gemini-embedding-001)
EMBEDDING_MODEL=models/gemini-embedding-001

# [OPTIONAL] HuggingFace CrossEncoder reranker model (default: BAAI/bge-reranker-base)
RERANKER_MODEL=BAAI/bge-reranker-base

# ------------------------------------------------------------------------------
# 3. CHUNKING & INGESTION STRATEGY
# ------------------------------------------------------------------------------
# [OPTIONAL] Target character length per document chunk (default: 500)
CHUNK_SIZE=500

# [OPTIONAL] Overlap character count between consecutive chunks (default: 50)
CHUNK_OVERLAP=50

# [OPTIONAL] Chunking strategy: "recursive" or "fixed" (default: recursive)
CHUNKER_STRATEGY=recursive

# ------------------------------------------------------------------------------
# 4. RETRIEVAL & RERANKING LIMITS
# ------------------------------------------------------------------------------
# [OPTIONAL] Number of candidate chunks retrieved in initial search (default: 10)
TOP_K_RETRIEVAL=10

# [OPTIONAL] Number of top chunks retained after reranking (default: 3)
TOP_K_RERANK=3

# [OPTIONAL] Enable hybrid (Dense Vector + Sparse BM25) retrieval (default: true)
USE_HYBRID_SEARCH=true

# ------------------------------------------------------------------------------
# 5. VECTOR DATABASE (QDRANT) & TRACE STORAGE (POSTGRESQL)
# ------------------------------------------------------------------------------
# [OPTIONAL for Qdrant Cloud] Qdrant Cloud Cluster Endpoint URL (e.g. https://xyz.cloud.qdrant.io:6333)
QDRANT_URL=

# [OPTIONAL for Qdrant Cloud] Qdrant API Key
QDRANT_API_KEY=

# [OPTIONAL for Local Qdrant] Qdrant Host address (default: localhost)
QDRANT_HOST=localhost

# [OPTIONAL for Local Qdrant] Qdrant HTTP Port (default: 6333)
QDRANT_PORT=6333

# [OPTIONAL] Qdrant Collection Name (default: rag_documents)
QDRANT_COLLECTION=rag_documents

# [OPTIONAL] PostgreSQL Connection URI for trace storage (default: postgresql://rag_user:rag_password@localhost:5432/rag_traces)
POSTGRES_URI=postgresql://rag_user:rag_password@localhost:5432/rag_traces

# ------------------------------------------------------------------------------
# 6. REGRESSION EVALUATION & QUALITY GATE THRESHOLDS
# ------------------------------------------------------------------------------
# [OPTIONAL] Minimum acceptable Recall@K ratio for CI/CD gates (default: 0.75)
MIN_RECALL_THRESHOLD=0.75

# [OPTIONAL] Minimum acceptable LLM-as-a-Judge Faithfulness score (default: 0.80)
MIN_FAITHFULNESS_THRESHOLD=0.80

# [OPTIONAL] Maximum allowable recall drop relative to baseline (default: 0.05)
MAX_RECALL_DROP_TOLERANCE=0.05

